# ========== GEO 智能内容优化平台 环境变量配置 ==========

# --- 应用配置 ---
APP_NAME=GEO 智能内容优化平台
APP_VERSION=2.0.0
DEBUG=false

# API Key 认证（必填，生产环境必须设置强密码；留空则不启用认证）
API_KEY=your-secret-api-key-here

# CORS 允许的来源（逗号分隔，生产环境必须改为具体域名白名单）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# --- 数据库 ---
# 默认 SQLite（开发用）；生产环境推荐 PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./geo_data.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/geo_db

# --- 文件上传 ---
UPLOAD_DIR=./uploads
KNOWLEDGE_DIR=./knowledge_base
MAX_UPLOAD_SIZE=10485760
ALLOWED_UPLOAD_EXTENSIONS=.txt,.md,.pdf,.docx,.doc

# --- 加密密钥 ---
# 凭据加密密钥（推荐生产环境设置；留空则自动生成，重启后旧密文不可解密）
GEO_ENCRYPTION_KEY=

# --- LLM 缓存 ---
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=3600
LLM_CACHE_MAX_SIZE=1000

# --- 汇率 ---
USD_TO_CNY_RATE=7.2

# --- 定时任务 ---
# 监测任务调度间隔（分钟）
MONITOR_INTERVAL_MINUTES=60

# --- 日志 ---
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 是否输出 JSON 结构化日志（生产环境推荐 true）
LOG_JSON=false
